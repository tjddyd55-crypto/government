# Railway CRM-government / environment: develop (development 역할)
# 실제 secret 은 Railway Variables 에만 설정. 이 파일은 예시·문서용.
# PostgreSQL 서비스명이 Postgres 가 아니면 DATABASE_URL reference 를 실제 이름에 맞게 수정.

NODE_ENV=production
PORT=8080

# PostgreSQL — government 전용 DB (보험 CRM-Platform DB 와 분리)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# 웹 공개 URL (Railway develop 도메인 확정 후 설정)
# VITE_BASE_URL / VITE_API_URL 은 Railway 웹 same-origin 이면 비워도 됨 (src/lib/apiClient.ts)
VITE_API_BASE_PATH=/backend
# VITE_BASE_URL=https://__YOUR_DEVELOP_RAILWAY_DOMAIN__
# VITE_PUBLIC_APP_URL=https://__YOUR_DEVELOP_RAILWAY_DOMAIN__

# 인증 (필수 — Railway 에서 직접 생성·설정)
JWT_SECRET=__SET_IN_RAILWAY__
# INVITE_SIGNUP_SECRET=__SET_IN_RAILWAY__  # 선택, 미설정 시 JWT_SECRET 사용

# R2 — government 파일 업로드 (필수, presign 사용)
R2_ACCOUNT_ID=__SET_IN_RAILWAY__
R2_ACCESS_KEY_ID=__SET_IN_RAILWAY__
R2_SECRET_ACCESS_KEY=__SET_IN_RAILWAY__
R2_BUCKET_NAME=__SET_IN_RAILWAY__
# R2_BUCKET=__SET_IN_RAILWAY__  # R2_BUCKET_NAME 과 동일 용도
# R2_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
R2_PUBLIC_CDN_BASE=__SET_IN_RAILWAY__

# government 테넌트 R2 접두 (server/lib/r2KeyPolicy.js — CRM_R2_OBJECT_ROOT)
CRM_R2_OBJECT_ROOT=crm-platform/development/government/tenants

# 서버 시작 로그 라벨 (Government CRM vs Insurance)
APP_PRODUCT=government
# 프론트 빌드 시 동일 값 사용 (vite.config.ts — /login 브랜딩·HomeRedirect)
VITE_APP_PRODUCT=government
# APP_INDUSTRY=government-support
# ENABLE_GOVERNMENT_SUPPORT=true
# SESSION_SECRET=__SET_IN_RAILWAY__
# PUBLIC_APP_URL=...
# R2_OBJECT_ROOT=...  # 코드는 CRM_R2_OBJECT_ROOT 사용

# --- 정부지원 CRM 관리자 (develop: PASSWORD 만으로 admin 비밀번호 동기화) ---
# Railway develop 에 GOVERNMENT_ADMIN_PASSWORD 만 설정해도 서버 기동 시 admin(기본) 비밀번호가 갱신됩니다.
# production 은 GOVERNMENT_ADMIN_BOOTSTRAP_ENABLED=true 또는 RESET=true 가 있어야 적용됩니다.
# GOVERNMENT_ADMIN_BOOTSTRAP_ENABLED=true
# GOVERNMENT_ADMIN_LOGIN_ID=admin
# GOVERNMENT_ADMIN_PASSWORD=__SET_IN_RAILWAY__
# GOVERNMENT_ADMIN_NAME=정부지원 CRM 관리자
# GOVERNMENT_ADMIN_RESET_PASSWORD_ON_BOOTSTRAP=false

# --- develop HTTP E2E (로컬 실행 시만, 값은 커밋 금지) ---
# E2E_BASE_URL=https://app-develop-9663.up.railway.app
# E2E_GOVERNMENT_PASSWORD=__SET_LOCALLY_OR_CI_SECRET__
# E2E_GOVERNMENT_ADMIN_LOGIN_ID=admin
# E2E_GOVERNMENT_USER_A=e2e_ua_dev
# E2E_GOVERNMENT_USER_B=e2e_ub_dev

# --- SMS (EC2 relay — 보험 CRM과 동일) ---
# Railway(정부지원) 필수: SMS_HTTP_GATEWAY_URL 만 설정. 알리고 자격증명(ALIGO_*)은 EC2 relay 서버에만 둡니다.
# EC2 고정 IP 100.54.92.161 — 알리고 발송 허용 IP
SMS_HTTP_GATEWAY_URL=http://100.54.92.161:3000/send-sms

# --- 정부지원 전자서명 카카오 알림톡 (develop = 최종 운영: live, allowlist 없음) ---
# GOVERNMENT_ALIMTALK_ENABLED=true
# GOVERNMENT_ALIMTALK_DRY_RUN=false
# GOVERNMENT_ALIMTALK_RELAY_URL=http://100.54.92.161:3000/send-alimtalk
# GOVERNMENT_ALIMTALK_RELAY_AUTH_TOKEN=__SET_IN_RAILWAY__
# GOVERNMENT_PUBLIC_BASE_URL=https://app-develop-9663.up.railway.app
# GOVERNMENT_ALIMTALK_TEMPLATE_CODE=__ALIGO_TEMPLATE_CODE__
# ALIMTALK_LIVE_TEST_RECIPIENT=   # 상시 운영 시 비움 (제한 발송용만 설정)
# EC2: ALIMTALK_DRY_RUN=false, failover=N 고정, SMS 자동대체 없음

# --- 정부지원 계정 인증번호 알림톡 (UJ_6183, 검수중: ENABLED=false → SMS 유지) ---
# GOVERNMENT_AUTH_ALIMTALK_ENABLED=false
# GOVERNMENT_AUTH_ALIMTALK_TEMPLATE_CODE=UJ_6183
# GOVERNMENT_AUTH_ALIMTALK_FALLBACK_SMS_ENABLED=true
# GOVERNMENT_AUTH_ALIMTALK_RELAY_URL=http://100.54.92.161:3000/send-auth-alimtalk
# (미설정 시 GOVERNMENT_ALIMTALK_RELAY_URL 의 /send-alimtalk → /send-auth-alimtalk 로 유도)
# Kakao credential·relay token 은 전자서명 알림톡과 동일 값 재사용
# 승인 후: template/list 확인 → GOVERNMENT_AUTH_ALIMTALK_ENABLED=true

# --- 선택 (기능별) ---
# LOG_LEVEL=info
# REDIS_URL=__SET_IN_RAILWAY__
# INSURANCE_SKIP_INIT_DB=false
